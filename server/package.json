  "dependencies": {
    "@teledesk/shared": "*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "multer": "^2.0.2",
    "pino": "^9.5.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "telegram": "^2.26.22",
    "zod": "^3.23.8"
