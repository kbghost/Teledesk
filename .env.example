NODE_ENV=development
PORT=5000
APP_NAME=TeleDesk

MONGODB_URI=mongodb://127.0.0.1:27017/teledesk
CLIENT_URL=http://localhost:5173
# URL publique HTTPS du serveur : nécessaire uniquement pour le mode « webhook » des bots Telegram (voir docs/telegram.md)
PUBLIC_URL=

# Secrets : générés automatiquement dans .env au premier lancement. NE JAMAIS les committer.
# TELEGRAM_SECRET_KEY chiffre (AES-256-GCM) les jetons de bot et les secrets 2FA en base : le perdre = devoir reconnecter les comptes.
JWT_ACCESS_SECRET=change_me
MEDIA_SIGNING_SECRET=change_me
TELEGRAM_SECRET_KEY=change_me

REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

EMAIL_PROVIDER=console
EMAIL_FROM=TeleDesk <no-reply@teledesk.local>
# Si EMAIL_PROVIDER=smtp (npm i nodemailer -w server) : smtps://utilisateur:motdepasse@hote:465
SMTP_URL=

# ── Telegram ─────────────────────────────────────────────
# API officielle (laisser par défaut ; modifié seulement par les tests automatiques)
TELEGRAM_API_BASE=https://api.telegram.org
# Bac à sable : faux serveur Telegram intégré (démo et tests sans Telegram). Actif par défaut hors production.
ALLOW_SANDBOX=true
# Démarre automatiquement les connexions Telegram (polling / webhooks) au lancement du serveur
TELEGRAM_AUTOSTART=true
# Durée d'attente (secondes) d'un appel getUpdates en mode polling
POLL_TIMEOUT_S=25
# Intervalle minimal entre deux envois sur un même compte Telegram (anti-flood), en millisecondes
OUTBOUND_MIN_INTERVAL_MS=1100

REQUIRE_EMAIL_VERIFICATION=false
# Pays bloqués (codes ISO, séparés par des virgules) via en-tête cf-ipcountry
BLOCKED_COUNTRIES=

# --- Plateforme ---
# Super admin créé au démarrage s'il n'existe pas
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Paiement des médias payants : simulated (page de test) ou stripe
PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_TTL_HOURS=72
# Compte personnel Telegram (MTProto, expérimental) : clés sur https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USER_MAX_SENDS_PER_HOUR=90
